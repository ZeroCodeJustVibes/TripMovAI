# Kept in sync with the repository-root .gitignore, so the exclusions hold
# whether git is initialised here or one level up.
input/
output/
out/
*.mp4
*.mov
*.MOV
*.mp3
*.wav
*.m4a
tmp/
map_frames/
timeline.json
narrative.json
music.json
places.json
.env
*.key
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Secrets: keep any .env variant out, but allow the template
.env.*
!.env.example

# Personal photos / exports that might get dropped in here
export/
immich_export/
*.jpg
*.jpeg
*.JPG
*.JPEG
*.heic
*.HEIC
